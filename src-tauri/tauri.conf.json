{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "editlicious",
  "version": "../package.json",
  "identifier": "io.github.krocon.editlicious",
  "build": {
    "frontendDist": "../dist/editlicious/browser",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "editlicious",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#17191d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "targets": ["deb", "rpm", "appimage", "dmg", "app", "msi", "nsis"],
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "homepage": "https://github.com/krocon/editlicious",
    "category": "DeveloperTool",
    "shortDescription": "A calm text editor for huge files",
    "longDescription": "editlicious is a keyboard-first, distraction-free text editor that opens and edits huge files – millions of lines, lines with millions of characters – on macOS, Windows and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "section": "editors" },
      "rpm": { "release": "1" },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
