{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "editlicious",
  "version": "../package.json",
  "identifier": "io.github.krocon.editlicious",
  "build": {
    "frontendDist": "../dist/editlicious/browser",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "editlicious",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#17191d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "homepage": "https://github.com/krocon/editlicious",
    "category": "DeveloperTool",
    "shortDescription": "A calm text editor for huge files",
    "longDescription": "editlicious is a keyboard-first, distraction-free text editor that opens and edits huge files – millions of lines, lines with millions of characters – on macOS, Windows and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "upgradeCode": "0caa1787-1c4b-4135-9849-889571ad0f40"
      }
    },
    "linux": {
      "deb": {
        "section": "editors",
        "desktopTemplate": "linux/editlicious.desktop"
      },
      "rpm": {
        "release": "1",
        "desktopTemplate": "linux/editlicious.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "text",
          "log",
          "md",
          "markdown",
          "csv",
          "tsv",
          "json",
          "jsonl",
          "xml",
          "yaml",
          "yml",
          "toml",
          "ini",
          "cfg",
          "conf",
          "properties",
          "env"
        ],
        "name": "Text document",
        "description": "Text document",
        "role": "Editor",
        "mimeType": "text/plain",
        "rank": "Alternate"
      },
      {
        "ext": [
          "rs",
          "ts",
          "tsx",
          "js",
          "mjs",
          "cjs",
          "jsx",
          "java",
          "kt",
          "py",
          "rb",
          "go",
          "c",
          "h",
          "cpp",
          "hpp",
          "cs",
          "swift",
          "php",
          "sh",
          "bash",
          "zsh",
          "ps1",
          "sql",
          "html",
          "htm",
          "css",
          "scss",
          "vue",
          "lua",
          "pl",
          "r",
          "scala",
          "dart",
          "gradle"
        ],
        "name": "Source code",
        "description": "Source code",
        "role": "Editor",
        "mimeType": "text/plain",
        "rank": "Alternate"
      }
    ]
  }
}
