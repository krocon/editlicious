{
  "name": "editlicious",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "tauri dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:mac:local": "tauri build --bundles app,dmg",
    "tauri:build:linux": "tauri build --bundles deb,rpm,appimage",
    "tauri:build:windows": "tauri build --bundles msi,nsis",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "check": "pnpm version:check && pnpm scripts:test && pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm rust:fmt && pnpm rust:lint && pnpm rust:test && pnpm notices:check && pnpm licenses:check",
    "site:demo": "bash scripts/site-demo.sh",
    "site:test": "node --test scripts/site.test.mjs",
    "mcp:build": "node scripts/mcp-sidecar.mjs",
    "mcp:dev": "node scripts/mcp-sidecar.mjs --dev",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "release:notes": "node scripts/release-notes.mjs",
    "scripts:test": "node --test \"scripts/*.test.mjs\"",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "licenses:report": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@tauri-apps/api": "^2.12.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
