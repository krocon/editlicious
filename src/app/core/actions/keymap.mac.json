{
  "global": {
    "Mod+q": "app.quit",
    "Mod+Ctrl+f": "view.fullscreen"
  },
  "editor": {
    "Alt+ArrowLeft": "cursor.wordLeft",
    "Alt+ArrowRight": "cursor.wordRight",
    "Alt+Shift+ArrowLeft": "select.wordLeft",
    "Alt+Shift+ArrowRight": "select.wordRight",
    "Mod+ArrowLeft": "cursor.lineStart",
    "Mod+ArrowRight": "cursor.lineEnd",
    "Mod+Shift+ArrowLeft": "select.lineStart",
    "Mod+Shift+ArrowRight": "select.lineEnd",
    "Mod+ArrowUp": "cursor.docStart",
    "Mod+ArrowDown": "cursor.docEnd",
    "Mod+Shift+ArrowUp": "select.docStart",
    "Mod+Shift+ArrowDown": "select.docEnd",
    "Alt+Backspace": "edit.deleteWordLeft",
    "Alt+Delete": "edit.deleteWordRight",
    "Mod+Alt+f": "find.replace",
    "Mod+g": "find.next",
    "Mod+Shift+g": "find.prev",
    "Mod+l": "goto.line",
    "Mod+Alt+Shift+ArrowLeft": "block.left",
    "Mod+Alt+Shift+ArrowRight": "block.right",
    "Mod+Alt+Shift+ArrowUp": "block.up",
    "Mod+Alt+Shift+ArrowDown": "block.down"
  }
}
