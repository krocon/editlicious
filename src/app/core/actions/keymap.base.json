{
  "global": {
    "Mod+n": "file.new",
    "Mod+o": "file.open",
    "Mod+s": "file.save",
    "Mod+Shift+s": "file.saveAs",
    "Mod+Alt+s": "file.saveAll",
    "Mod+w": "file.close",
    "Mod+Shift+w": "file.closeAll",
    "Ctrl+Tab": "file.next",
    "Ctrl+Shift+Tab": "file.prev",
    "F10": "file.next",
    "Shift+F10": "file.prev"
  },
  "editor": {
    "ArrowLeft": "cursor.left",
    "ArrowRight": "cursor.right",
    "ArrowUp": "cursor.up",
    "ArrowDown": "cursor.down",
    "Home": "cursor.lineStart",
    "End": "cursor.lineEnd",
    "PageUp": "cursor.pageUp",
    "PageDown": "cursor.pageDown",
    "Mod+Home": "cursor.docStart",
    "Mod+End": "cursor.docEnd",
    "Shift+ArrowLeft": "select.left",
    "Shift+ArrowRight": "select.right",
    "Shift+ArrowUp": "select.up",
    "Shift+ArrowDown": "select.down",
    "Shift+Home": "select.lineStart",
    "Shift+End": "select.lineEnd",
    "Shift+PageUp": "select.pageUp",
    "Shift+PageDown": "select.pageDown",
    "Mod+Shift+Home": "select.docStart",
    "Mod+Shift+End": "select.docEnd",
    "Enter": "edit.newline",
    "Shift+Enter": "edit.newline",
    "Backspace": "edit.backspace",
    "Shift+Backspace": "edit.backspace",
    "Delete": "edit.delete",
    "Tab": "edit.indent",
    "Shift+Tab": "edit.outdent",
    "Insert": "edit.toggleOverwrite",
    "Mod+a": "edit.selectAll",
    "Mod+z": "edit.undo",
    "Mod+Shift+z": "edit.redo",
    "Mod+c": "edit.copy",
    "Mod+x": "edit.cut",
    "Mod+v": "edit.paste"
  }
}
