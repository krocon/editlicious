{
  "global": {
    "F11": "view.fullscreen",
    "Mod+m": "view.toggleMenuBar",
    "Mod+q": "app.quit"
  },
  "editor": {
    "Mod+ArrowLeft": "cursor.wordLeft",
    "Mod+ArrowRight": "cursor.wordRight",
    "Mod+Shift+ArrowLeft": "select.wordLeft",
    "Mod+Shift+ArrowRight": "select.wordRight",
    "Mod+ArrowUp": "view.scrollUp",
    "Mod+ArrowDown": "view.scrollDown",
    "Mod+Backspace": "edit.deleteWordLeft",
    "Mod+Delete": "edit.deleteWordRight",
    "Mod+y": "edit.redo",
    "Mod+h": "find.replace",
    "Mod+g": "goto.line",
    "Alt+Shift+ArrowLeft": "block.left",
    "Alt+Shift+ArrowRight": "block.right",
    "Alt+Shift+ArrowUp": "block.up",
    "Alt+Shift+ArrowDown": "block.down"
  }
}
